      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Plot comparison\n",
    "comparison_df.plot(kind = 'bar', x = 'Model', y = 'Best Test Accuracy', legend = False)\n",
    "plt.title('Model Comparison on Breast Cancer Wisconsin Dataset')\n",
    "plt.ylabel('Test Accuracy')\n",
    "plt.xticks(rotation = 0)\n",
    "plt.ylim(0.9, 1.0)  # Adjust the range for better clarity if needed\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3aea37ae-5f67-4af0-b039-59909d0881a0",
   "metadata": {},
   "source": [
    "## Random Forest Feature Importance Heatmap for Breast Cancer Wisconsin Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "39368627-33c7-41b7-9a13-7e5fda826255",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x800 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Initialize dictionary to store feature importances\n",
    "feature_importances = {partition: [] for partition in partitions.keys()}\n",
    "\n",
    "# Collect feature importances for each trial in each partition\n",
    "for partition_name, (X_train, X_test, y_train, y_test) in partitions.items():\n",
    "    for trial in range(3):\n",
    "        # Train a Random Forest model with the best parameters\n",
    "        rf = RandomForestClassifier(n_estimators = 10, criterion = 'gini', max_depth = None, random_state = 42)\n",
    "        rf.fit(X_train, y_train)\n",
    "\n",
    "        # Append the feature importances\n",
    "        feature_importances[partition_name].append(rf.feature_importances_)\n",
    "\n",
    "# Average the feature importances across trials for each partition\n",
    "avg_feature_importances = {\n",
    "    partition: np.mean(importances, axis = 0)\n",
    "    for partition, importances in feature_importances.items()\n",
    "}\n",
    "\n",
    "# Convert the results into a DataFrame for heatmap visualization\n",
    "feature_importance_df = pd.DataFrame(avg_feature_importances, index = X_train.columns)\n",
    "\n",
    "# Plot the heatmap\n",
    "plt.figure(figsize = (12, 8))\n",
    "sns.heatmap(feature_importance_df, annot = True, cmap = \"YlGnBu\", fmt = \".2f\")\n",
    "plt.title(\"Random Forest Feature Importance Heatmap (Breast Cancer dataset\")\n",
    "plt.xlabel(\"Partitions\")\n",
    "plt.ylabel(\"Features\")\n",
    "plt.show()"
   ]
  },
